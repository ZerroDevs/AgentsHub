<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>AgentsHub.Program</StartupObject>
    <RootNamespace>AgentsHub</RootNamespace>
    <AssemblyName>AgentsHub</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>

    <!-- إعدادات التوافق مع المصمم -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Makes the style rules in .editorconfig build errors, so the IDE and `dotnet build` agree. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Metadata -->
    <AssemblyTitle>Agents Hub</AssemblyTitle>
    <AssemblyDescription>Agents Hub - Multi-Agent Desktop Hub and CLI Workspace</AssemblyDescription>
    <Product>Agents Hub</Product>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Version>2.0.0</Version>
    <NoWarn>$(NoWarn);MSB3277;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Platform specific targets -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- The DeepSeek engine needs WebView2, so it only exists in the desktop build. -->
    <DefineConstants>$(DefineConstants);DEEPSEEK_UI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <UseWindowsForms>false</UseWindowsForms>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="MainForm.cs" />
    <Compile Remove="MainForm.Designer.cs" />
    <Compile Remove="CliWebviewForm.cs" />
    <Compile Remove="CliWebviewForm.Designer.cs" />
    <Compile Remove="HudTerminalForm.cs" />
    <Compile Remove="HudTerminalForm.Designer.cs" />
    <Compile Remove="ManageClisForm.cs" />
    <Compile Remove="ManageClisForm.Designer.cs" />
    <Compile Remove="Forms\**\*.cs" />
    <Compile Remove="Services\DeepSeek\**\*.cs" />
    <!-- Qwen drives a WebView2 page the way DeepSeek does, so it is desktop-only too. Its parsing
         lives in Services\Qwen\QwenTools.cs and never in the DeepSeek files. -->
    <Compile Remove="Services\Qwen\**\*.cs" />
    <EmbeddedResource Remove="**\*.resx" />
  </ItemGroup>

  <!-- Per-profile OAuth tokens are user data and must never be swept into a build output. -->
  <ItemGroup>
    <Content Remove="Profiles\**" />
    <None Remove="Profiles\**" />
    <EmbeddedResource Remove="Profiles\**" />
  </ItemGroup>

  <!-- Separate project living under tools/. Its obj/ output would otherwise be globbed into this
       build and produce duplicate assembly attributes. -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <!-- The regression tests are their own project and must not compile into the app. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentsHub.Security.Tests" />
  </ItemGroup>

  <!-- تفعيل خصائص الـ Trimming و SingleFile فقط أثناء الـ Publish ليبقى المصمم يعمل بسلاسة -->
  <PropertyGroup Condition="'$(PublishProtocol)' != '' or '$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcTrimReflection>true</IlcTrimReflection>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);MSB3277;IL2104;NETSDK1175;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="AgentsHub" />
    <RuntimeHostConfigurationOption Include="System.Runtime.InteropServices.BuiltInComInterop.IsSupported" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.WinForms" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ui\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="ui\dist\**" Condition="Exists('ui\dist')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <None Update="scripts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="bin\win-x64\AgentsEngine.exe" Condition="Exists('bin\win-x64\AgentsEngine.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="bin\osx-arm64\AgentsEngine" Condition="Exists('bin\osx-arm64\AgentsEngine')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="bin\linux-x64\AgentsEngine" Condition="Exists('bin\linux-x64\AgentsEngine')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>


  <!-- Terminate any running instance before build to prevent MSB3021 file lock -->
  <Target Name="CloseRunningInstance" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -Command &quot;Get-Process -Name 'AgentsHub' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;" IgnoreExitCode="true" />
  </Target>

  <!-- Ensure precompiled cross-platform sidecar binaries are always included in publish packages -->
  <Target Name="CopySidecarToPublish" AfterTargets="Publish">
    <Copy SourceFiles="bin\win-x64\AgentsEngine.exe" DestinationFolder="$(PublishDir)bin\win-x64" Condition="Exists('bin\win-x64\AgentsEngine.exe')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="bin\osx-arm64\AgentsEngine" DestinationFolder="$(PublishDir)bin\osx-arm64" Condition="Exists('bin\osx-arm64\AgentsEngine')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="bin\linux-x64\AgentsEngine" DestinationFolder="$(PublishDir)bin\linux-x64" Condition="Exists('bin\linux-x64\AgentsEngine')" SkipUnchangedFiles="true" />
  </Target>

</Project>
